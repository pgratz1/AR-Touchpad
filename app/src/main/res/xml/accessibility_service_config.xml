<?xml version="1.0" encoding="utf-8"?>
<!--
  Accessibility service configuration for TouchpadAccessibilityService.

  accessibilityEventTypes="typeAllMask"
      Receive every event type so we can detect TYPE_VIEW_FOCUSED on the external display.

  accessibilityFlags:
    flagReportViewIds            — lets us read source.window.displayId to identify the glasses.
    flagRetrieveInteractiveWindows — required to see windows on non-default (glasses) displays.

  canRetrieveWindowContent="true"
      Required to read source.window and source.isEditable from accessibility events.

  canPerformGestures is deliberately NOT set. Setting it makes AccessibilityManagerService
  install AccessibilityInputFilter with motion-event injection, which demultiplexes input
  per source: the moment our uinput mouse emits a REL event mid-drag, the filter tears down
  the in-flight touchscreen stream and the app receives ACTION_CANCEL. The finger gesture
  then dies ~100 ms in, so the cursor twitches once and freezes for the rest of the drag.
  Nothing here needs the capability — the nav bar uses performGlobalAction(), which is
  always available; only dispatchGesture() requires it, and the dispatchGesture-based
  helpers in TouchpadAccessibilityService have no callers.
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeAllMask"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:settingsActivity=".MainActivity" />
